{
  "name": "label",
  "version": "1.0.0",
  "description": "Herramienta completa para gestionar, controlar y escalar tu negocio",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run server --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:prod": "npm run build:prod --prefix frontend",
    "deploy:check": "node scripts/preDeployCheck.js",
    "deploy": "node scripts/deploy.js",
    "test:all": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test-monitoring --prefix backend",
    "test:frontend": "npm run test:performance --prefix frontend"
  },
  "keywords": ["business", "management", "pos", "inventory", "finance"],
  "author": "Label Team",
  "license": "PRIVATE",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}